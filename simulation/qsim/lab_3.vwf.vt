// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "10/14/2026 15:30:27"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    Lab3
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module Lab3_vlg_sample_tst(
	clk,
	key,
	sampler_tx
);
input  clk;
input [0:0] key;
output sampler_tx;

reg sample;
time current_time;
always @(clk or key)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
    if ($realtime == 0 || $realtime != current_time)  
    begin                                             
        if (sample === 1'bx)                          
            sample = 0;                               
        else                                          
            sample = ~sample;                         
    end                                               
    current_time = $realtime;                         
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module Lab3_vlg_check_tst (
	ledr,
	uart_tx,
	sampler_rx
);
input [0:0] ledr;
input  uart_tx;
input sampler_rx;

reg [0:0] ledr_expected;
reg  uart_tx_expected;

reg [0:0] ledr_prev;
reg  uart_tx_prev;

reg [0:0] ledr_expected_prev;
reg  uart_tx_expected_prev;

reg [0:0] last_ledr_exp;
reg  last_uart_tx_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:2] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 2'b1;
end

// update real /o prevs

always @(trigger)
begin
	ledr_prev = ledr;
	uart_tx_prev = uart_tx;
end

// update expected /o prevs

always @(trigger)
begin
	ledr_expected_prev = ledr_expected;
	uart_tx_expected_prev = uart_tx_expected;
end



// expected ledr
initial
begin
	ledr_expected[0] = 1'bX;
end 

// expected ledr[0]
initial
begin
	ledr_expected[0] = 1'bX;
end 

// expected uart_tx
initial
begin
	uart_tx_expected = 1'bX;
end 
// generate trigger
always @(ledr_expected or ledr or uart_tx_expected or uart_tx)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected ledr = %b | expected uart_tx = %b | ",ledr_expected_prev,uart_tx_expected_prev);
	$display("| real ledr = %b | real uart_tx = %b | ",ledr_prev,uart_tx_prev);
`endif
	if (
		( ledr_expected_prev !== 1'bx ) && ( ledr_prev !== ledr_expected_prev )
		&& ((ledr_expected_prev !== last_ledr_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ledr :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ledr_expected_prev);
		$display ("     Real value = %b", ledr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ledr_exp = ledr_expected_prev;
	end
	if (
		( uart_tx_expected_prev !== 1'bx ) && ( uart_tx_prev !== uart_tx_expected_prev )
		&& ((uart_tx_expected_prev !== last_uart_tx_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port uart_tx :: @time = %t",  $realtime);
		$display ("     Expected value = %b", uart_tx_expected_prev);
		$display ("     Real value = %b", uart_tx_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_uart_tx_exp = uart_tx_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#6000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Lab3_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg [0:0] key;
// wires                                               
wire [0:0] ledr;
wire uart_tx;

wire sampler;                             

// assign statements (if any)                          
Lab3 i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.key(key),
	.ledr(ledr),
	.uart_tx(uart_tx)
);

// clk
always
begin
	clk = 1'b0;
	clk = #10000 1'b1;
	#10000;
end 

// key
initial
begin
	key[0] = 1'b0;
end 

// key[0]
initial
begin
	key[0] = 1'b1;
	key[0] = #1000000 1'b0;
	key[0] = #200000 1'b1;
end 

Lab3_vlg_sample_tst tb_sample (
	.clk(clk),
	.key(key),
	.sampler_tx(sampler)
);

Lab3_vlg_check_tst tb_out(
	.ledr(ledr),
	.uart_tx(uart_tx),
	.sampler_rx(sampler)
);
endmodule

